<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- development = installable on your registered devices (needs Apple
         Development cert). app-store = for TestFlight + App Store (needs
         Apple Distribution cert). Match this to the cert type in
         BUILD_CERTIFICATE_BASE64. -->
    <key>method</key>
    <string>development</string>

    <!-- Team ID — 9739J3GQ4Z is CONGREGATION ZEH LZEH. Overridable via
         APPLE_TEAM_ID secret if the workflow substitutes it in. -->
    <key>teamID</key>
    <string>__TEAM_ID__</string>

    <!-- Let Xcode automatically pick the signing cert + profile from the
         keychain the workflow set up. -->
    <key>signingStyle</key>
    <string>automatic</string>

    <key>uploadSymbols</key>
    <true/>
    <key>compileBitcode</key>
    <false/>
</dict>
</plist>
