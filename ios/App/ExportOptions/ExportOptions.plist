<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- app-store = for TestFlight + App Store (needs Apple Distribution cert).
         Switched back to app-store now that the Distribution cert is in place. -->
    <key>method</key>
    <string>app-store</string>

    <!-- Team ID — 9739J3GQ4Z is CONGREGATION ZEH LZEH. Substituted at build
         time from the APPLE_TEAM_ID secret. -->
    <key>teamID</key>
    <string>__TEAM_ID__</string>

    <!-- Let Xcode automatically pick the signing cert + profile from the
         keychain the workflow set up. -->
    <key>signingStyle</key>
    <string>automatic</string>

    <key>uploadSymbols</key>
    <true/>
    <key>compileBitcode</key>
    <false/>
</dict>
</plist>
